# TEMPLATE ONLY. Copy to deploy/.env on the host and do not commit it.
# DNS must point the hostname to the VM before starting the TLS proxy.
SHARDS_GATEWAY_DOMAIN=gateway.example.com

# These must be the configured values of your independent OAuth provider.
SHARDS_OAUTH_ISSUER=https://identity.example.com/
SHARDS_OAUTH_JWKS_URI=https://identity.example.com/.well-known/jwks.json

# Comma-separated exact browser Origin values. Empty denies browser Origin headers.
SHARDS_ALLOWED_ORIGINS=
