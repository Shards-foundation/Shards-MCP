# Register OAuth applications and configure these values server-side only.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Internal gateway URL, never supplied by browser input.
SHARDS_GATEWAY_INTERNAL_URL=http://127.0.0.1:8787
# Dedicated local gateway agent credential with ONLY agent:read scope. Never use SHARDS_ADMIN_TOKEN.
# Server-side secret: configure through a secret manager, never NEXT_PUBLIC_.
SHARDS_CONSOLE_READ_TOKEN=
# Private-preview provider:subject allowlist (e.g. github:123456,discord:987654); empty denies all.
SHARDS_CONSOLE_ALLOWED_IDENTITIES=

# Apple Sign in — configured on Apple Developer portal (secret is the signed client-secret JWT)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Sign in with ChatGPT: ONLY for an approved OpenAI partner OAuth registration.
CHATGPT_CLIENT_ID=
CHATGPT_CLIENT_SECRET=
CHATGPT_OIDC_ISSUER=
# An ordinary social login creates a portal session. Only operator subjects below can open /console.
# NEVER put gateway bootstrap tokens in these environment variables.
