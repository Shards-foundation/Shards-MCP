# Register OAuth applications and configure these values server-side only.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Internal gateway URL, never supplied by browser input.
SHARDS_GATEWAY_INTERNAL_URL=http://127.0.0.1:8787
# Explicit private-preview allowlist; empty denies every social login.
SHARDS_CONSOLE_ALLOWED_EMAILS=
